<Window x:Class="Snake.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Snake"
        mc:Ignorable="d"
        Title="Snake Game" Height="520" Width="520"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        KeyDown="Window_KeyDown"
        Background="{DynamicResource WindowBackgroundBrush}">
    <Window.Resources>
        <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#1a1a2e"/>
        <SolidColorBrush x:Key="HeaderBackgroundBrush" Color="#0b132b"/>
        <SolidColorBrush x:Key="ScoreBarBackgroundBrush" Color="#16213e"/>
        <SolidColorBrush x:Key="PlayerModeForegroundBrush" Color="#00e676"/>
        <SolidColorBrush x:Key="AccentForegroundBrush" Color="#e94560"/>
        <SolidColorBrush x:Key="SpeedLabelForegroundBrush" Color="#aaaacc"/>
        <SolidColorBrush x:Key="GameAreaBackgroundBrush" Color="#0f3460"/>
        <SolidColorBrush x:Key="PrimaryForegroundBrush" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="OverlayBackgroundBrush" Color="#AA000000"/>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="40"/>
            <RowDefinition Height="40"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="{StaticResource HeaderBackgroundBrush}">
            <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,10,0">
                    <TextBlock Text="Speed:" FontSize="13"
                               Foreground="{StaticResource SpeedLabelForegroundBrush}"
                               VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <ComboBox x:Name="SpeedComboBox" Width="90" FontSize="13"
                              Background="{StaticResource GameAreaBackgroundBrush}" Foreground="{DynamicResource OverlayBackgroundBrush}"
                              BorderBrush="{StaticResource AccentForegroundBrush}"
                              SelectionChanged="SpeedComboBox_SelectionChanged" Margin="0,0,10,0">
                        <ComboBoxItem Content="Slow" Tag="500"/>
                        <ComboBoxItem Content="Normal" Tag="150" IsSelected="True"/>
                        <ComboBoxItem Content="Fast" Tag="80"/>
                        <ComboBoxItem Content="Ultra" Tag="10"/>
                    </ComboBox>
                    <Button Content="Stop" Width="70" Height="26"
                            Background="{StaticResource AccentForegroundBrush}"
                            Foreground="{StaticResource PrimaryForegroundBrush}"
                            BorderBrush="{StaticResource AccentForegroundBrush}"
                            FontWeight="Bold"
                            Click="StopButton_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Score bar -->
        <Border Grid.Row="1" Background="{StaticResource ScoreBarBackgroundBrush}">
            <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center">
                    <TextBlock x:Name="PlayerModeText" Text="HUMAN" FontSize="20" FontWeight="Bold"
                               Foreground="{StaticResource PlayerModeForegroundBrush}" Margin="10,0"/>
                    <TextBlock x:Name="ScoreText" Text="Score: 0" FontSize="20" FontWeight="Bold"
                               Foreground="{StaticResource AccentForegroundBrush}" Margin="10,0"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Game area -->
        <Border Grid.Row="2" Margin="10" Background="{StaticResource GameAreaBackgroundBrush}" CornerRadius="4">
            <Grid>
                <Canvas x:Name="GameCanvas" ClipToBounds="True"/>

                <!-- Overlay for game over / start -->
                <Border x:Name="OverlayPanel" Background="{StaticResource OverlayBackgroundBrush}" Visibility="Visible">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                        <TextBlock x:Name="OverlayTitle" Text="SNAKE GAME" FontSize="36" FontWeight="Bold"
                                   Foreground="{StaticResource AccentForegroundBrush}" HorizontalAlignment="Center"/>
                        <TextBlock x:Name="OverlayMessage" Text="Press SPACE to start" FontSize="18"
                                   Foreground="{StaticResource PrimaryForegroundBrush}" HorizontalAlignment="Center" Margin="0,10,0,0"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>
