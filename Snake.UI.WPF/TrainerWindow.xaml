<Window x:Class="Snake.AI.TrainerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Snake.AI"
        mc:Ignorable="d"
        Title="Snake AI Trainer" Height="650" Width="950"
        WindowStartupLocation="CenterScreen"
        Background="#F5F5F5">
    
    <Window.Resources>
        <!-- Modern Card Style -->
        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="20"/>
            <Setter Property="Margin" Value="10"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="10" ShadowDepth="2" Opacity="0.2" Color="#000000"/>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Modern Button Style -->
        <Style x:Key="ModernButton" TargetType="Button">
            <Setter Property="Background" Value="#2196F3"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="20,10"/>
            <Setter Property="Margin" Value="5"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                CornerRadius="4" 
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#1976D2"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="#BDBDBD"/>
                    <Setter Property="Cursor" Value="Arrow"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Label Style -->
        <Style x:Key="LabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="#424242"/>
            <Setter Property="Margin" Value="0,8,0,4"/>
            <Setter Property="FontWeight" Value="Medium"/>
        </Style>

        <!-- Input Style -->
        <Style x:Key="InputStyle" TargetType="TextBox">
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="BorderBrush" Value="#BDBDBD"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Width" Value="100"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
        </Style>

        <!-- Slider Style -->
        <Style x:Key="ModernSlider" TargetType="Slider">
            <Setter Property="Margin" Value="0,5,0,0"/>
            <Setter Property="Height" Value="24"/>
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="1"
                       Text="Snake AI Training" 
                       FontSize="28" 
                       FontWeight="Bold" 
                       Foreground="#212121"
                       VerticalAlignment="Center"/>
        </Grid>

        <!-- Main Content -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.2*"/>
                <ColumnDefinition Width="2*"/>
            </Grid.ColumnDefinitions>

            <!-- Left Panel - Image -->
            <Border Grid.Column="0" Style="{StaticResource CardStyle}">
                <StackPanel>
                    <TextBlock 
                               FontSize="18" 
                               FontWeight="SemiBold" 
                               Foreground="#212121"
                               Text="{Binding Text, ElementName=ConfigNameTextBox, StringFormat=Model: {0}}"
                               Margin="0,0,0,15"><Run Language="de-de"/>
                               
                    </TextBlock>

                    <!-- Image Display -->
                    <Border BorderBrush="#E0E0E0" 
                            BorderThickness="2" 
                            CornerRadius="4"
                            Height="100"
                            Background="#FAFAFA">
                        <Image x:Name="TrainingImage" 
                               Stretch="Uniform"
                               Margin="10"/>
                    </Border>

                    <!-- Image Selection Button -->
                    <Button x:Name="SelectImageButton"
                            Content="Choose Custom Image"
                            Style="{StaticResource ModernButton}"
                            Background="#4CAF50"
                            Margin="0,15,0,0"
                            Click="SelectImageButton_Click" Visibility="Collapsed"/>

                    <!-- Saved Models Section -->
                    <Border Background="#FFF3E0" 
                            CornerRadius="4" 
                            Padding="15" 
                            Margin="0,20,0,0">
                        <StackPanel>
                            <TextBlock Text="Saved AI Models" 
                                       FontWeight="SemiBold" 
                                       Foreground="#E65100"
                                       Margin="0,0,0,8"/>
                            <Button x:Name="LoadModelButton"
                                    Content="📂 Load Saved Model"
                                    Style="{StaticResource ModernButton}"
                                    Background="#FF6F00"
                                    Margin="0,5,0,0"
                                    Click="LoadModelButton_Click"/>
                            <TextBlock x:Name="LoadedModelText" 
                                       Text="No model loaded" 
                                       Foreground="#757575"
                                       FontSize="11"
                                       Margin="0,8,0,0"
                                       TextWrapping="Wrap"/>
                            
                            <!-- Report Buttons -->
                            <StackPanel x:Name="ReportButtonsPanel" 
                                        Visibility="Collapsed"
                                        Margin="0,10,0,0">
                                <TextBlock Text="View Reports" 
                                           FontWeight="SemiBold" 
                                           Foreground="#E65100"
                                           Margin="0,0,0,8"/>
                                <Button x:Name="OpenHtmlReportButton"
                                        Content="📊 Open HTML Report"
                                        Style="{StaticResource ModernButton}"
                                        Background="#00897B"
                                        FontSize="12"
                                        Padding="10,6"
                                        Margin="0,2,0,0"
                                        Click="OpenHtmlReportButton_Click"/>
                                <Button x:Name="OpenCsvReportButton"
                                        Content="📄 Open CSV Report"
                                        Style="{StaticResource ModernButton}"
                                        Background="#00897B"
                                        FontSize="12"
                                        Padding="10,6"
                                        Margin="0,5,0,0"
                                        Click="OpenCsvReportButton_Click"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Status Panel -->
                    <Border Background="#E3F2FD" 
                            CornerRadius="4" 
                            Padding="15" 
                            Margin="0,20,0,0">
                        <StackPanel>
                            <TextBlock Text="Training Status" 
                                       FontWeight="SemiBold" 
                                       Foreground="#1565C0"
                                       Margin="0,0,0,8"/>
                            <TextBlock x:Name="StatusText" 
                                       Text="Ready to train" 
                                       Foreground="#424242"
                                       TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>

            <!-- Right Panel - Parameters with Tabs -->
            <Border Grid.Column="1" Style="{StaticResource CardStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0"
                               Text="Training Parameters" 
                               FontSize="18" 
                               FontWeight="SemiBold" 
                               Foreground="#212121"
                               Margin="0,0,0,15"/>

                    <!-- Tab Control -->
                    <TabControl Grid.Row="1" 
                                BorderThickness="0"
                                Margin="0,5,0,0">
                        
                        <!-- Basic Tab -->
                        <TabItem Header="Basic" FontSize="14" Padding="15,8">
                            <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,10,0,0">
                                <StackPanel>
                                    <!-- Configuration Name -->
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="Configuration Name" Style="{StaticResource LabelStyle}"/>
                                        <TextBlock Text="ℹ️" 
                                                   FontSize="14" 
                                                   Margin="5,0,0,0" 
                                                   VerticalAlignment="Center"
                                                   Cursor="Help"
                                                   ToolTip="Enter a name for this training configuration (e.g., 'High Exploration Test')"/>
                                    </StackPanel>
                                    <TextBox x:Name="ConfigNameTextBox" 
                                             Text="Training_Config" 
                                             Style="{StaticResource InputStyle}"
                                             Width="300"
                                             Margin="0,0,0,15"/>
                                    
                                    <!-- Episodes -->
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="Number of Episodes" Style="{StaticResource LabelStyle}"/>
                                        <TextBlock Text="ℹ️" 
                                                   FontSize="14" 
                                                   Margin="5,0,0,0" 
                                                   VerticalAlignment="Center"
                                                   Cursor="Help"
                                                   ToolTip="Total training iterations (1,000 - 1,000,000)"/>
                                    </StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Slider x:Name="EpisodesSlider" 
                                                Grid.Column="0"
                                                Minimum="1000" 
                                                Maximum="1000000" 
                                                Value="100000"
                                                TickFrequency="10000"
                                                IsSnapToTickEnabled="True"
                                                Style="{StaticResource ModernSlider}"
                                                ValueChanged="EpisodesSlider_ValueChanged"/>
                                        <TextBox x:Name="EpisodesTextBox" 
                                                 Grid.Column="1"
                                                 Text="100000" 
                                                 Style="{StaticResource InputStyle}"
                                                 Margin="10,0,0,0"
                                                 TextChanged="EpisodesTextBox_TextChanged"/>
                                    </Grid>

                                    <!-- Max Steps Per Episode -->
                                    <StackPanel Orientation="Horizontal" Margin="0,20,0,0">
                                        <TextBlock Text="Max Steps Per Episode" Style="{StaticResource LabelStyle}" Margin="0,0,0,4"/>
                                        <TextBlock Text="ℹ️" 
                                                   FontSize="14" 
                                                   Margin="5,0,0,0" 
                                                   VerticalAlignment="Center"
                                                   Cursor="Help"
                                                   ToolTip="Maximum steps before episode terminates (100 - 10,000)"/>
                                    </StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Slider x:Name="MaxStepsSlider" 
                                                Grid.Column="0"
                                                Minimum="100" 
                                                Maximum="10000" 
                                                Value="5000"
                                                TickFrequency="100"
                                                IsSnapToTickEnabled="True"
                                                Style="{StaticResource ModernSlider}"
                                                ValueChanged="MaxStepsSlider_ValueChanged"/>
                                        <TextBox x:Name="MaxStepsTextBox" 
                                                 Grid.Column="1"
                                                 Text="5000" 
                                                 Style="{StaticResource InputStyle}"
                                                 Margin="10,0,0,0"
                                                 TextChanged="MaxStepsTextBox_TextChanged"/>
                                    </Grid>
                                </StackPanel>
                            </ScrollViewer>
                        </TabItem>

                        <!-- Advanced Tab -->
                        <TabItem Header="Advanced" FontSize="14" Padding="15,8">
                            <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,10,0,0">
                                <StackPanel>
                                    <!-- Learning Rate -->
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="Learning Rate (Alpha)" Style="{StaticResource LabelStyle}"/>
                                        <TextBlock Text="ℹ️" 
                                                   FontSize="14" 
                                                   Margin="5,0,0,0" 
                                                   VerticalAlignment="Center"
                                                   Cursor="Help"
                                                   ToolTip="How quickly the agent learns (0.001 - 1.0) - Standard Q-learning uses α ∈ [0.05, 0.3]"/>
                                    </StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Slider x:Name="AlphaSlider" 
                                                Grid.Column="0"
                                                Minimum="0.001" 
                                                Maximum="1.0" 
                                                Value="0.1"
                                                TickFrequency="0.001"
                                                Style="{StaticResource ModernSlider}"
                                                ValueChanged="AlphaSlider_ValueChanged"/>
                                        <TextBox x:Name="AlphaTextBox" 
                                                 Grid.Column="1"
                                                 Text="0.1" 
                                                 Style="{StaticResource InputStyle}"
                                                 Margin="10,0,0,0"
                                                 TextChanged="AlphaTextBox_TextChanged"/>
                                    </Grid>

                                    <!-- Discount Factor -->
                                    <StackPanel Orientation="Horizontal" Margin="0,15,0,0">
                                        <TextBlock Text="Discount Factor (Gamma)" Style="{StaticResource LabelStyle}" Margin="0,0,0,4"/>
                                        <TextBlock Text="ℹ️" 
                                                   FontSize="14" 
                                                   Margin="5,0,0,0" 
                                                   VerticalAlignment="Center"
                                                   Cursor="Help"
                                                   ToolTip="Importance of future rewards (0.0 - 1.0) - Common range: 0.9–0.99"/>
                                    </StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Slider x:Name="GammaSlider" 
                                                Grid.Column="0"
                                                Minimum="0.0" 
                                                Maximum="1.0" 
                                                Value="0.99"
                                                TickFrequency="0.01"
                                                IsSnapToTickEnabled="True"
                                                Style="{StaticResource ModernSlider}"
                                                ValueChanged="GammaSlider_ValueChanged"/>
                                        <TextBox x:Name="GammaTextBox" 
                                                 Grid.Column="1"
                                                 Text="0.99" 
                                                 Style="{StaticResource InputStyle}"
                                                 Margin="10,0,0,0"
                                                 TextChanged="GammaTextBox_TextChanged"/>
                                    </Grid>

                                    <!-- Exploration Rate -->
                                    <StackPanel Orientation="Horizontal" Margin="0,15,0,0">
                                        <TextBlock Text="Initial/Starting Exploration Rate (Epsilon Start)" Style="{StaticResource LabelStyle}" Margin="0,0,0,4"/>
                                        <TextBlock Text="ℹ️" 
                                                   FontSize="14" 
                                                   Margin="5,0,0,0" 
                                                   VerticalAlignment="Center"
                                                   Cursor="Help"
                                                   ToolTip="Starting exploration probability (0.0 - 1.0), normally Start with full exploration (1.0)."/>
                                    </StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Slider x:Name="EpsilonStartSlider" 
                                                Grid.Column="0"
                                                Minimum="0.0" 
                                                Maximum="1.0" 
                                                Value="1.0"
                                                TickFrequency="0.01"
                                                IsSnapToTickEnabled="True"
                                                Style="{StaticResource ModernSlider}"
                                                ValueChanged="EpsilonStartSlider_ValueChanged"/>
                                        <TextBox x:Name="EpsilonStartTextBox" 
                                                 Grid.Column="1"
                                                 Text="1.0" 
                                                 Style="{StaticResource InputStyle}"
                                                 Margin="10,0,0,0"
                                                 TextChanged="EpsilonStartTextBox_TextChanged"/>
                                    </Grid>

                                    <!-- Minimum Exploration Rate -->
                                    <StackPanel Orientation="Horizontal" Margin="0,15,0,0">
                                        <TextBlock Text="Minimum Exploration Rate (Epsilon Min)" Style="{StaticResource LabelStyle}" Margin="0,0,0,4"/>
                                        <TextBlock Text="ℹ️" 
                                                   FontSize="14" 
                                                   Margin="5,0,0,0" 
                                                   VerticalAlignment="Center"
                                                   Cursor="Help"
                                                   ToolTip="Minimum exploration rate to maintain (0.0 - 0.5) - Typical values: 0.01–0.1"/>
                                    </StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Slider x:Name="EpsilonMinSlider" 
                                                Grid.Column="0"
                                                Minimum="0.0" 
                                                Maximum="0.5" 
                                                Value="0.01"
                                                TickFrequency="0.01"
                                                IsSnapToTickEnabled="True"
                                                Style="{StaticResource ModernSlider}"
                                                ValueChanged="EpsilonMinSlider_ValueChanged"/>
                                        <TextBox x:Name="EpsilonMinTextBox" 
                                                 Grid.Column="1"
                                                 Text="0.01" 
                                                 Style="{StaticResource InputStyle}"
                                                 Margin="10,0,0,0"
                                                 TextChanged="EpsilonMinTextBox_TextChanged"/>
                                    </Grid>

                                    <!-- Epsilon Decay -->
                                    <StackPanel Orientation="Horizontal" Margin="0,15,0,0">
                                        <TextBlock Text="Exploration Decay Rate (Epsilon Decay)" Style="{StaticResource LabelStyle}" Margin="0,0,0,4"/>
                                        <TextBlock Text="ℹ️" 
                                                   FontSize="14" 
                                                   Margin="5,0,0,0" 
                                                   VerticalAlignment="Center"
                                                   Cursor="Help"
                                                   ToolTip="How fast exploration decreases per Step (0.00001 - 0.0001)"/>
                                    </StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Slider x:Name="EpsilonDecaySlider" 
                                                Grid.Column="0"
                                                Minimum="0.00001" 
                                                Maximum="0.0001" 
                                                Value="0.00001"
                                                TickFrequency="0.001"
                                                Style="{StaticResource ModernSlider}"
                                                ValueChanged="EpsilonDecaySlider_ValueChanged"/>
                                        <TextBox x:Name="EpsilonDecayTextBox" 
                                                 Grid.Column="1"
                                                 Text="0.00001" 
                                                 Style="{StaticResource InputStyle}"
                                                 Margin="10,0,0,0"
                                                 TextChanged="EpsilonDecayTextBox_TextChanged"/>
                                    </Grid>

                                    <!-- Report Interval -->
                                    <StackPanel Orientation="Horizontal" Margin="0,15,0,0">
                                        <TextBlock Text="Progress Report Interval" Style="{StaticResource LabelStyle}" Margin="0,0,0,4"/>
                                        <TextBlock Text="ℹ️" 
                                                   FontSize="14" 
                                                   Margin="5,0,0,0" 
                                                   VerticalAlignment="Center"
                                                   Cursor="Help"
                                                   ToolTip="Show progress every N episodes (10 - 1,000)"/>
                                    </StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Slider x:Name="ReportIntervalSlider" 
                                                Grid.Column="0"
                                                Minimum="10" 
                                                Maximum="1000" 
                                                Value="100"
                                                TickFrequency="10"
                                                IsSnapToTickEnabled="True"
                                                Style="{StaticResource ModernSlider}"
                                                ValueChanged="ReportIntervalSlider_ValueChanged"/>
                                        <TextBox x:Name="ReportIntervalTextBox" 
                                                 Grid.Column="1"
                                                 Text="100" 
                                                 Style="{StaticResource InputStyle}"
                                                 Margin="10,0,0,0"
                                                 TextChanged="ReportIntervalTextBox_TextChanged"/>
                                    </Grid>
                                </StackPanel>
                            </ScrollViewer>
                        </TabItem>
                    </TabControl>

                    <!-- Action Buttons -->
                    <StackPanel Grid.Row="2"
                                Orientation="Horizontal" 
                                HorizontalAlignment="Right" 
                                Margin="0,15,0,0">
                        <Button x:Name="BackFooterButton"
                                Content="Back"
                                Style="{StaticResource ModernButton}"
                                Background="#9E9E9E"
                                Foreground="White"
                                Margin="0,0,10,0"
                                Height="44"
                                VerticalAlignment="Center"
                                Click="BackButton_Click"/>

                        <Button x:Name="StartTrainingButton"
                                Content="Start Training"
                                Style="{StaticResource ModernButton}"
                                Height="44"
                                VerticalAlignment="Center"
                                Click="StartTrainingButton_Click"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
